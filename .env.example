# =============================================================================
# AI Factory — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- LLM API Keys (at least one required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# --- Default Models ---
# Premium model (used for Master Agent, PMs, Assessment)
AIFACTORY_PREMIUM_MODEL=anthropic/claude-sonnet-4-20250514
# Standard model (used for Team Leads)
AIFACTORY_STANDARD_MODEL=google/gemini-2.5-flash
# Budget model (used for Workers)
AIFACTORY_BUDGET_MODEL=google/gemini-2.5-flash

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- General ---
AIFACTORY_LOG_LEVEL=INFO
AIFACTORY_MAX_BUDGET_USD=5.00
AIFACTORY_MAX_ITERATIONS=50
