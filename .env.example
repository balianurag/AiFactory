# =============================================================================
# AI Factory — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── OpenRouter (recommended — single key for 300+ models) ────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Direct provider keys (optional — only needed if NOT using OpenRouter) ─────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# ── Model routing (direct OpenAI SDK) ────────────────────────────────────────
# Use direct OpenAI model names (gpt-4o, gpt-4o-mini, etc.)
AIFACTORY_PREMIUM_MODEL=gpt-4o
AIFACTORY_STANDARD_MODEL=gpt-4o-mini
AIFACTORY_BUDGET_MODEL=gpt-4o-mini

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
# Local Docker:  http://localhost:6333
# Qdrant Cloud:  https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Budget / Limits ───────────────────────────────────────────────────────────
AIFACTORY_MAX_BUDGET_USD=5.00
AIFACTORY_MAX_ITERATIONS=50
AIFACTORY_MAX_TOTAL_TOKENS=500000

# ── Logging ───────────────────────────────────────────────────────────────────
AIFACTORY_LOG_LEVEL=INFO
