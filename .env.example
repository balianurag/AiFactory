# =============================================================================
# AI Factory — Environment Variables
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env      (or: make env)
#
# Lines starting with # are comments and are not loaded.
# =============================================================================

# ── LLM API Keys (at least one required) ─────────────────────────────────────
ANTHROPIC_API_KEY=           # claude-* models (recommended for best quality)
OPENAI_API_KEY=              # gpt-* models AND text-embedding-3-small (memory)
# OPENROUTER_API_KEY=        # single key for 300+ models via openrouter.ai
# VOYAGE_API_KEY=            # voyage embeddings — best quality (optional)
# COHERE_API_KEY=            # cohere embeddings (optional)
# GOOGLE_API_KEY=            # Gemini models (optional)
# XAI_API_KEY=               # Grok models (optional)

# ── Model routing overrides (optional — model_registry.yaml used by default) ─
# AIFACTORY_PREMIUM_MODEL=anthropic/claude-opus-4-5
# AIFACTORY_STANDARD_MODEL=anthropic/claude-sonnet-4-5
# AIFACTORY_BUDGET_MODEL=openai/gpt-4o-mini

# ── Databases ─────────────────────────────────────────────────────────────────
# Run:  make db-up   to start both services in Docker
QDRANT_URL=http://localhost:6333       # vector DB — agent memory + semantic cache
QDRANT_API_KEY=                        # only needed for Qdrant Cloud
REDIS_URL=redis://localhost:6379/0     # task store + embedding cache
DATABASE_URL=postgresql://aifactory:aifactory_dev@localhost:5432/aifactory

# ── Observability (optional — LangSmith tracing) ─────────────────────────────
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=aifactory
# LANGCHAIN_TRACING_V2=true

# ── Integrations (optional) ───────────────────────────────────────────────────
# COMPOSIO_API_KEY=          # Composio tool integrations (GitHub, Jira, Slack, etc.)
# E2B_API_KEY=               # E2B cloud sandbox (fallback if Docker MCP is not running)
MCP_AUTH_TOKEN=              # Bearer token for the Docker MCP sandbox server

# ── Budget / Safety limits ─────────────────────────────────────────────────────
AIFACTORY_MAX_BUDGET_USD=5.00
AIFACTORY_MAX_ITERATIONS=50
AIFACTORY_MAX_TOTAL_TOKENS=500000

# ── Docker Compose settings (only used when running via docker compose) ───────
# These are referenced in docker-compose.yml; safe to leave as defaults for dev.
POSTGRES_PASSWORD=aifactory_dev
REDIS_PASSWORD=                # leave blank to disable Redis auth

# ── AI Factory Runtime Settings ───────────────────────────────────────────────
# AIFACTORY_DEFAULT_MODE=balanced             # best | balanced | cost_efficient
# AIFACTORY_LOG_LEVEL=INFO
# AIFACTORY_STREAM_TOKENS_ENABLED=true        # stream tokens to stdout in real-time
# AIFACTORY_MEMORY_PIPELINE_ENABLED=true      # enable 3-layer agent memory
# AIFACTORY_SEMANTIC_CACHE_ENABLED=true       # deduplicate semantically similar queries
# AIFACTORY_JUDGE_DEEP_EVAL_ENABLED=false     # LLM deep-eval of output quality (costs tokens)
# AIFACTORY_SANDBOX_DOCKER_ENABLED=false      # set true after running: make sandbox-up
# AIFACTORY_RL_ENABLED=true                   # adaptive model selection via RL-lite scoring

# ── Production hardening (Phase 6.1) — all flags default OFF ─────────────────
# Postgres-backed LangGraph checkpointer (crash-resume across process restarts).
# Requires langgraph-checkpoint-postgres + a reachable DATABASE_URL.
# Falls back to in-memory + a warning if unreachable.
# AIFACTORY_PIPELINE_CHECKPOINTER=memory       # memory | postgres
# AIFACTORY_CHECKPOINT_POOL_MIN_SIZE=2
# AIFACTORY_CHECKPOINT_POOL_MAX_SIZE=10

# TypedDict pipeline state with reducers + Send-API worker fan-out.
# Parallel workers each contribute rows; the reducer merges concurrent writes
# instead of the last writer clobbering peers. STANDARD / FULL / EXTENDED only.
# AIFACTORY_STATE_REDUCERS_ENABLED=false

# Tiered vector memory: Qdrant for hot layers, Milvus for cold layers.
# Milvus Lite (embedded) by default — set AIFACTORY_MILVUS_URI to a full
# server for production. Fail-soft: Milvus errors fall back to Qdrant.
# AIFACTORY_VECTOR_TIERED_ENABLED=false
# AIFACTORY_MILVUS_URI=./milvus.db             # or milvus://host:19530
# AIFACTORY_MILVUS_COLD_LEVELS=global          # comma-separated: global,team
