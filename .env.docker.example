# =============================================================================
# AiFactory — Docker Environment Template
# Copy to .env.docker and fill in real values:
#   cp .env.docker.example .env.docker
# =============================================================================

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Option A: OpenRouter (recommended — access to 300+ models via one key)
OPENROUTER_API_KEY=

# Option B: Direct provider keys (only needed if bypassing OpenRouter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# ── Model routing (LiteLLM format) ───────────────────────────────────────────
# OpenRouter format: openrouter/<provider>/<model>
AIFACTORY_PREMIUM_MODEL=openrouter/anthropic/claude-sonnet-4-5
AIFACTORY_STANDARD_MODEL=openrouter/google/gemini-2.0-flash-001
AIFACTORY_BUDGET_MODEL=openrouter/google/gemini-2.0-flash-001

# ── Qdrant Vector DB ─────────────────────────────────────────────────────────
# Self-hosted (Docker — default for full-stack compose):
#   QDRANT_URL is set to http://qdrant:6333 automatically inside docker-compose.yml
#   Leave these blank when using the bundled qdrant service.
#
# Qdrant Cloud (for Render / remote deployments):
#   Sign up at https://cloud.qdrant.io — free 1 GB cluster
#   QDRANT_URL=https://<cluster-id>.<region>.gcp.cloud.qdrant.io
#   QDRANT_API_KEY=<your-api-key>
QDRANT_URL=
QDRANT_API_KEY=

# ── Budget / Limits ───────────────────────────────────────────────────────────
AIFACTORY_MAX_BUDGET_USD=5.00
AIFACTORY_MAX_ITERATIONS=50
AIFACTORY_MAX_TOTAL_TOKENS=500000

# ── Logging ───────────────────────────────────────────────────────────────────
AIFACTORY_LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by docker-compose for both the postgres service and the backend DATABASE_URL
POSTGRES_PASSWORD=aifactory_dev

# ── Redis (optional password — leave blank to disable auth) ──────────────────
REDIS_PASSWORD=
