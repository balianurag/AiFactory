# ─────────────────────────────────────────────────────────────────────────────
# AI Factory — MCP Sandbox Server Image
#
# Runs the FastMCP server (sandbox_server.py) that manages the container pool
# and exposes execute_python / execute_bash / execute_javascript tools.
#
# Build: docker build -t aifactory-mcp-server:latest -f docker/sandbox/Dockerfile.mcp .
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim

# ── Step 1: copy Zscaler cert and activate it ─────────────────────────────────
# ca-certificates is tiny — plain HTTP to deb.debian.org works fine here.
COPY docker/sandbox/certs/zscaler.crt /usr/local/share/ca-certificates/zscaler.crt
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

# ── Step 2: switch apt sources to HTTPS (Zscaler handles HTTPS cleanly) ──────
RUN sed -i \
    -e 's|http://deb.debian.org|https://deb.debian.org|g' \
    -e 's|http://security.debian.org|https://security.debian.org|g' \
    /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r mcpserver --gid=999 && \
    useradd -r -g mcpserver --uid=999 --home-dir=/app --shell=/bin/bash mcpserver

WORKDIR /app

# Trust the cert for pip / requests
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# --prefer-binary: use pre-built wheels, no build-essential needed
RUN pip install --no-cache-dir --prefer-binary \
    "fastmcp>=0.9,<2.0" \
    "docker>=7.0,<8.0" \
    "uvicorn>=0.27,<1.0" \
    "starlette>=0.36,<1.0" \
    "httpx>=0.26,<1.0" \
    "structlog>=24.0,<26.0" \
    "pydantic>=2.5,<3.0" \
    "pydantic-settings>=2.1,<3.0"

# Copy the AI Factory source (only what the MCP server needs)
COPY src/aifactory/mcp/ ./aifactory/mcp/
COPY src/aifactory/core/sandbox_pool.py ./aifactory/core/
COPY src/aifactory/config/settings.py ./aifactory/config/
COPY src/aifactory/config/package_registry.yaml ./aifactory/config/
COPY src/aifactory/__init__.py ./aifactory/

RUN mkdir -p ./aifactory/core ./aifactory/config && \
    touch ./aifactory/__init__.py ./aifactory/core/__init__.py ./aifactory/config/__init__.py

RUN chown -R mcpserver:mcpserver /app

USER mcpserver

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8

EXPOSE 8100

CMD ["python", "-m", "aifactory.mcp.sandbox_server", "--transport", "streamable-http", "--port", "8100"]
